# Copie para .env e preencha. O .env nunca vai para o git.

# Troque SENHA pela senha do usuário "postgres" que você criou ao instalar o PostgreSQL.
DATABASE_URL="postgresql://postgres:SENHA@localhost:5432/clinica"
# Banco separado para os testes automáticos: ele é apagado a cada rodada.
DATABASE_URL_TESTE="postgresql://postgres:SENHA@localhost:5432/clinica_teste"

# Segredo que assina o login. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SEGREDO=""

PORTA=3001
# Endereço do front, para o CORS (só precisa se o front rodar em outro endereço).
ORIGEM_WEB="http://localhost:5173"

# Senha de todos os usuários fictícios criados pelo "npm run db:seed" (só desenvolvimento).
SEED_SENHA="troque-esta-senha"

# ── E-mail da clínica (confirmação de consultas) ─────────────────────────────
# Preencha com o e-mail da clínica. No Gmail, SMTP_SENHA é uma "senha de app"
# (Conta Google > Segurança > Verificação em duas etapas > Senhas de app),
# não a senha normal. Com SMTP_HOST="json" nada é enviado (modo de teste).
SMTP_HOST="smtp.gmail.com"
SMTP_PORTA=587
SMTP_USUARIO=""
SMTP_SENHA=""
# Nome e e-mail que aparecem como remetente.
EMAIL_REMETENTE="Clínica <email-da-clinica@exemplo.com>"
# Endereço do sistema na internet, usado no link de confirmação que vai no e-mail.
URL_PUBLICA="http://localhost:5173"

# ── WhatsApp e SMS (EM ESPERA: veja server/src/mensagens.ts) ─────────────────
# WHATSAPP_TOKEN=""
# WHATSAPP_NUMERO_ID=""
# SMS_URL=""
# SMS_TOKEN=""
# SMS_REMETENTE=""
