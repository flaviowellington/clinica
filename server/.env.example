# Copie para .env e preencha. O .env nunca vai para o git.

# Troque SENHA pela senha do usuário "postgres" que você criou ao instalar o PostgreSQL.
DATABASE_URL="postgresql://postgres:SENHA@localhost:5432/clinica"
# Banco separado para os testes automáticos: ele é apagado a cada rodada.
DATABASE_URL_TESTE="postgresql://postgres:SENHA@localhost:5432/clinica_teste"

# Segredo que assina o login. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SEGREDO=""

PORTA=3001
# Endereço do front, para o CORS (só precisa se o front rodar em outro endereço).
ORIGEM_WEB="http://localhost:5173"

# Senha de todos os usuários fictícios criados pelo "npm run db:seed" (só desenvolvimento).
SEED_SENHA="troque-esta-senha"
