    PESSOA {
      number id
      string Type "PATIENT|DENTIST"
      string Name
      date BirthDate
      string DocumentId "CPF"
      string MobilePhone
    }
    AGENDAMENTO {
      number id
      date date
      string fromTime
      string toTime
      number StatusId
      object AlertInfo
      number CheckinTime
    }
    TRATAMENTO {
      number id
      string IsEstimate
      string Status "OPEN|APPROVED"
      date ApprovedDate
    }
    ITEM_TRATAMENTO {
      number id
      string Tooth
      string Surface
      number Amount
      boolean Executed
    }
    PLANO_PAGAMENTO {
      number id
      string Type "CHARGE"
      string PaymentType "TOTAL|PROCEDURE"
      number InstallmentsCount
    }
    PARCELA {
      number Sequence
      date DueDate
      number PaymentForm_CharacteristicId
      number Amount
    }
    CLINICA {
      number id
      string Name
      number SlotTime
      object WorkingDaysHours
    }
    STATUS {
      number id
      string Type
      string Description
      string Color
    }
    ALERTA_RETORNO {
      number id
      number AtomicDate
      string Reason
    }
    TABELA_PRECOS {
      number id
      string Name
      date ValidFrom
    }
    PRECO {
      number id
      string ProcedureName
      number Amount
      number ProcedureCost
    }
